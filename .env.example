# Required unless GIGGLE_FAKE_LLM=1
OPENAI_API_KEY=replace-me
MONGO_URI=mongodb://localhost:27017/fake_google

# Demo mode: a simulated provider invents everything; no API key or cost.
# GIGGLE_FAKE_LLM=1

# Guardrails
# GIGGLE_DAILY_BUDGET_USD=5        # stop calling the model after this spend per UTC day
# GIGGLE_RATE_LIMIT_PER_MIN=30     # per client IP, for search, page, and roast
# GIGGLE_PRICES_JSON={"gpt-4o": [2.5, 10]}   # USD per 1M tokens (input, output)

# Optional fallback provider (any OpenAI-compatible API)
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://api.deepseek.com
# FALLBACK_MODEL=deepseek-flash

# Gunicorn
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
